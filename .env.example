# RFP Evaluation System - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# OpenAI API Key (required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for evaluation (optional, defaults to gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens for LLM response (optional, defaults to 4000)
MAX_TOKENS=4000

# Temperature for LLM (optional, defaults to 0.2 for more deterministic output)
# Range: 0.0 (deterministic) to 1.0 (creative)
TEMPERATURE=0.2
